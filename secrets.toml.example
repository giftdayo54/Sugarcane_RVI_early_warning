# Copy this file to .streamlit/secrets.toml for local runs (that file is
# gitignored). On Streamlit Community Cloud, paste the same keys into
# your app's Settings -> Secrets instead of committing a secrets.toml.

SH_CLIENT_ID = "your-sentinel-hub-client-id"
SH_CLIENT_SECRET = "your-sentinel-hub-client-secret"

# Only needed if you're not using the free Copernicus Data Space Ecosystem deployment.
# SH_BASE_URL = "https://sh.dataspace.copernicus.eu"
# SH_TOKEN_URL = "https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token"
